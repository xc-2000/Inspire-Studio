FROM maven:3.9.11-eclipse-temurin-21
WORKDIR /app
COPY maven-settings.xml /opt/maven/settings.xml
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -q -s /opt/maven/settings.xml -DskipTests dependency:go-offline
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 mvn -q -s /opt/maven/settings.xml '-Dtest=AiTaskServiceTest#shouldApplyDefaultResolutionBeforePricingAndSnapshot+shouldUseConfiguredGatewayDurationAndPrice+shouldRejectUnconfiguredDurationBeforeCharge,PersistenceServiceTest#shouldRoundTripConfiguredVideoDurations+shouldRejectUnpricedDefaultResolution+shouldRoundTripVideoCreditUnit' test
